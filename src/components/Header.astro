---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Música', href: '/musica' },
  { label: 'Videos', href: '/videos' },
  { label: 'Fotos', href: '/fotos' },
  { label: 'Ilustraciones', href: '/ilustraciones' },
  { label: 'Bio', href: '/bio' },
  { label: 'Contacto', href: '/contacto' },
];
---

<!-- ======================================================
     HEADER PRINCIPAL
====================================================== -->

<header
  class="fixed
         top-0
         left-0
         z-50
         w-full
         border-b
         border-white/10
         bg-black/95
         backdrop-blur-md"
>

  <div
    class="section-container
           flex
           h-20
           items-center
           justify-between"
  >

    <!-- ==================================================
         LOGO
    =================================================== -->

    <a
      href="/"
      class="block shrink-0"
      aria-label="Nementia - Inicio"
    >
      <img
        src="/images/nementia-logo.webp"
        alt="Nementia"
        width="512"
        height="141"
        class="w-[145px]
               md:w-[160px]
               lg:w-[175px]
               h-auto"
      />
    </a>


    <!-- ==================================================
         NAVEGACIÓN ESCRITORIO
    =================================================== -->

    <nav
      class="hidden
             lg:flex
             items-center
             gap-7
             font-heading
             text-[12px]
             tracking-[0.18em]
             uppercase"
      aria-label="Navegación principal"
    >
      {
        navItems.map((item) => {
          const isActive =
            item.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(item.href);

          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'relative py-2 transition-colors duration-300',
                isActive
                  ? 'text-white'
                  : 'text-gray-400 hover:text-white'
              ]}
            >
              {item.label}

              {
                isActive && (
                  <span
                    class="absolute
                          left-1/2
                          -bottom-1
                          h-px
                          w-6
                          -translate-x-1/2
                          bg-red-600"
                    aria-hidden="true"
                  ></span>
                )
              }
            </a>
          );
        })
      }
    </nav>


    <!-- ==================================================
         REDES SOCIALES ESCRITORIO
    =================================================== -->

    <div
      class="hidden
             lg:flex
             items-center
             gap-5
             text-gray-500
             text-sm"
    >

      <a
        href="https://open.spotify.com/artist/013o3IJujXyd1L4cCUTi6p"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Spotify"
        class="hover:text-white transition-colors duration-300"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
          <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm4.587 14.424a.622.622 0 0 1-.855.207c-2.343-1.431-5.294-1.755-8.77-.961a.622.622 0 1 1-.277-1.213c3.805-.87 7.067-.498 9.695 1.108a.622.622 0 0 1 .207.859Zm1.221-2.716a.778.778 0 0 1-1.07.258c-2.684-1.649-6.776-2.127-9.95-1.164a.778.778 0 1 1-.451-1.489c3.628-1.101 8.136-.568 11.213 1.323a.778.778 0 0 1 .258 1.072Zm.105-2.827C14.694 8.97 9.382 8.795 6.31 9.727a.934.934 0 1 1-.542-1.787c3.527-1.07 9.397-.864 13.096 1.331a.934.934 0 1 1-.951 1.61Z" />
        </svg>
      </a>

      <a
        href="https://www.youtube.com/@nementia_band"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="YouTube"
        class="hover:text-white transition-colors duration-300"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.376.505A3.016 3.016 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.376-.505a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z" />
        </svg>
      </a>

      <a
        href="https://www.instagram.com/nementia_band"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="hover:text-white transition-colors duration-300"
