        </svg>
      </a>

    </div>


    <!-- ==================================================
         BOTÓN MENÚ MÓVIL
    =================================================== -->

    <button
      id="mobile-menu-button"
      type="button"
      class="lg:hidden
             flex
             items-center
             justify-center
             w-10
             h-10
             text-gray-300
             hover:text-white
             transition-colors
             duration-300"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >

      <!-- ICONO HAMBURGUESA -->
      <svg
        id="menu-open-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="w-7 h-7"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          d="M4 7h16M4 12h16M4 17h16"
        />
      </svg>

      <!-- ICONO CERRAR -->
      <svg
        id="menu-close-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="hidden w-7 h-7"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          d="M6 6l12 12M18 6L6 18"
        />
      </svg>

    </button>

  </div>


  <!-- ==================================================
       MENÚ MÓVIL
  =================================================== -->

  <div
    id="mobile-menu"
    class="hidden
           lg:hidden
           absolute
           top-20
           left-0
           w-full
           max-h-[calc(100dvh-5rem)]
           overflow-y-auto
           overscroll-contain
           bg-black/98
           border-t
           border-white/10
           backdrop-blur-md"
  >

    <div
      class="section-container
             py-8
             flex
             flex-col
             items-center"
    >

      <!-- NAVEGACIÓN -->
      <nav
        class="flex
               flex-col
               items-center
               gap-5
               font-heading
               text-[13px]
               tracking-[0.25em]
               uppercase"
        aria-label="Navegación móvil"
      >
        {
          navItems.map((item) => {
            const isActive =
              item.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(item.href);

            return (
              <a
                href={item.href}
                data-mobile-link
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'relative py-2 transition-colors duration-300',
                  isActive
                    ? 'text-white'
                    : 'text-gray-400 hover:text-white'
                ]}
              >
                {item.label}

                {
                  isActive && (
                    <span
                      class="absolute
                            left-1/2
                            -bottom-0
                            h-px
                            w-6
                            -translate-x-1/2
                            bg-red-600"
                      aria-hidden="true"
                    ></span>
                  )
                }
              </a>
            );
          })
        }
      </nav>


      <!-- SEPARADOR -->
      <div
        class="w-10
               h-px
               bg-red-800
               my-7"
      ></div>


      <!-- REDES SOCIALES -->
      <div
        class="flex
               items-center
               justify-center
               gap-7
               text-gray-500
               text-lg"
      >

        <a
          href="https://open.spotify.com/artist/013o3IJujXyd1L4cCUTi6p"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Spotify"
          class="hover:text-white transition-colors duration-300"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm4.587 14.424a.622.622 0 0 1-.855.207c-2.343-1.431-5.294-1.755-8.77-.961a.622.622 0 1 1-.277-1.213c3.805-.87 7.067-.498 9.695 1.108a.622.622 0 0 1 .207.859Zm1.221-2.716a.778.778 0 0 1-1.07.258c-2.684-1.649-6.776-2.127-9.95-1.164a.778.778 0 1 1-.451-1.489c3.628-1.101 8.136-.568 11.213 1.323a.778.778 0 0 1 .258 1.072Zm.105-2.827C14.694 8.97 9.382 8.795 6.31 9.727a.934.934 0 1 1-.542-1.787c3.527-1.07 9.397-.864 13.096 1.331a.934.934 0 1 1-.951 1.61Z" />
          </svg>
        </a>

        <a
          href="https://www.youtube.com/@nementia_band"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
          class="hover:text-white transition-colors duration-300"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.376.505A3.016 3.016 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.376-.505a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z" />
          </svg>
        </a>

        <a
          href="https://www.instagram.com/nementia_band"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="hover:text-white transition-colors duration-300"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path d="M7.75 2h8.5A5.756 5.756 0 0 1 22 7.75v8.5A5.756 5.756 0 0 1 16.25 22h-8.5A5.756 5.756 0 0 1 2 16.25v-8.5A5.756 5.756 0 0 1 7.75 2Zm0 2A3.754 3.754 0 0 0 4 7.75v8.5A3.754 3.754 0 0 0 7.75 20h8.5A3.754 3.754 0 0 0 20 16.25v-8.5A3.754 3.754 0 0 0 16.25 4Zm8.75 1.5a1 1 0 1 1-1 1 1 1 0 0 1 1-1ZM12 7a5 5 0 1 1-5 5 5.006 5.006 0 0 1 5-5Zm0 2a3 3 0 1 0 3 3 3.003 3.003 0 0 0-3-3Z" />
          </svg>
        </a>

        <a
          href="https://www.facebook.com/nementia.band"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="hover:text-white transition-colors duration-300"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path d="M13.5 22v-9h3l.5-3h-3.5V8.2c0-.868.241-1.46 1.485-1.46H17V4.06A26.9 26.9 0 0 0 14.69 4C12.404 4 10.84 5.395 10.84 7.96V10H8v3h2.84v9Z" />
          </svg>
        </a>

        <a
          href="https://music.apple.com/cl/artist/nementia/1712198198"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Apple Music"
          class="hover:text-white transition-colors duration-300"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.79 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09ZM12.03 7.25C11.88 5.02 13.69 3.18 15.77 3c.29 2.58-2.34 4.5-3.74 4.25Z" />
          </svg>
        </a>

      </div>

    </div>

  </div>

</header>


<!-- ======================================================
     JAVASCRIPT MENÚ MÓVIL
====================================================== -->

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>('#mobile-menu-button');

  const mobileMenu =
    document.querySelector<HTMLElement>('#mobile-menu');

  const openIcon =
    document.querySelector<HTMLElement>('#menu-open-icon');

  const closeIcon =
    document.querySelector<HTMLElement>('#menu-close-icon');

  const mobileLinks =
    document.querySelectorAll<HTMLElement>('[data-mobile-link]');


  function openMenu() {
    if (!menuButton || !mobileMenu || !openIcon || !closeIcon) return;

    mobileMenu.classList.remove('hidden');

    openIcon.classList.add('hidden');
    closeIcon.classList.remove('hidden');

    menuButton.setAttribute('aria-expanded', 'true');
    menuButton.setAttribute('aria-label', 'Cerrar menú');

    document.body.style.overflow = 'hidden';
  }


  function closeMenu() {
    if (!menuButton || !mobileMenu || !openIcon || !closeIcon) return;

    mobileMenu.classList.add('hidden');

    openIcon.classList.remove('hidden');
    closeIcon.classList.add('hidden');

    menuButton.setAttribute('aria-expanded', 'false');
    menuButton.setAttribute('aria-label', 'Abrir menú');

    document.body.style.overflow = '';
  }


  menuButton?.addEventListener('click', () => {

    const isOpen =
      menuButton.getAttribute('aria-expanded') === 'true';

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }

  });


  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });


  document.addEventListener('keydown', (event) => {

    if (event.key === 'Escape') {
      closeMenu();
    }

  });


  window.addEventListener('resize', () => {

    if (window.innerWidth >= 1024) {
      closeMenu();
    }

  });
</script>
