---
import BaseLayout from '../layouts/BaseLayout.astro';

const ilustraciones = [
  {
    numero: 'I',
    titulo: 'Nementia',
    imagen: '/images/1-nementia.jpeg',
    width: 1215,
    height: 1215,
  },
  {
    numero: 'II',
    titulo: 'Dryas',
    imagen: '/images/2-dryas.jpeg',
    width: 1800,
    height: 1800,
  },
  {
    numero: 'III',
    titulo: 'Inerte',
    imagen: '/images/3-inerte.jpeg',
    width: 1204,
    height: 1204,
  },
  {
    numero: 'IV',
    titulo: 'Irreflejo',
    imagen: '/images/4-irreflejo.jpeg',
    width: 1210,
    height: 1210,
  },
  {
    numero: 'V',
    titulo: 'Paro',
    imagen: '/images/5-paro.jpg',
    width: 1800,
    height: 1800,
  },
  {
    numero: 'VI',
    titulo: 'Menguante',
    imagen: '/images/6-menguante.jpg',
    width: 1800,
    height: 1800,
  },
  {
    numero: 'VII',
    titulo: 'Nodus Tollens',
    imagen: '/images/7-nodus-tollens.jpeg',
    width: 1210,
    height: 1210,
  },
  {
    numero: 'VIII',
    titulo: 'Snag',
    imagen: '/images/8-snag.jpg',
    width: 1800,
    height: 1800,
  },
];
---

<BaseLayout
  title="Ilustraciones | Nementia"
  description="Ilustraciones asociadas a las canciones de Vita Est In Morte."
>

  <main id="main-content" class="bg-black min-h-screen">

    <!-- ======================================================
         BANNER
    ====================================================== -->

    <section
      class="relative
             overflow-hidden
             min-h-[300px]
             md:min-h-[360px]
             flex
             items-center"
    >

      <!-- Imagen de fondo -->
      <div
        class="absolute
               inset-0
               bg-cover
               bg-[position:center_60%]"
        style="background-image: url('/images/banner5.jpeg');"
      ></div>

      <!-- Overlay general -->
      <div
        class="absolute
               inset-0
               bg-black/45"
      ></div>

      <!-- Gradiente inferior -->
      <div
        class="absolute
               inset-0
               bg-gradient-to-t
               from-black
               via-black/20
               to-black/10"
      ></div>

      <!-- Contenido del banner -->
      <div
        class="section-container
               relative
               z-10
               text-center"
      >

        <div class="translate-y-12">

          <p
            class="font-heading
                   text-[11px]
                   md:text-xs
                   tracking-[0.4em]
                   uppercase
                   text-red-500"
          >
            Vita Est In Morte
          </p>

          <h1
            class="mt-4
                   font-display
                   text-[2rem]
                   sm:text-5xl
                   md:text-6xl
                   lg:text-7xl
                   uppercase
                   text-white"
          >
            Ilustraciones
          </h1>

          <div
            class="mx-auto
                   mt-6
                   h-px
                   w-12
                   bg-red-700"
          ></div>

        </div>

      </div>

    </section>


    <!-- ======================================================
         GALERÍA
    ====================================================== -->

    <section
      class="pb-20
             md:pb-24"
    >

      <div class="section-container">

        <!-- Encabezado de sección -->
        <div
          class="pt-0
                 pb-10
                 md:pb-12"
        >

          <p
            class="font-heading
                   text-[11px]
                   md:text-xs
                   tracking-[0.4em]
                   uppercase
                   text-red-500"
          >
            Arte conceptual
          </p>

          <h2
            class="mt-3
                   font-display
                   text-4xl
                   md:text-5xl
                   uppercase
                   text-white"
          >
            Vita Est In Morte
          </h2>

          <div
            class="mt-5
                   h-px
                   w-12
                   bg-red-700"
          ></div>

          <!-- CRÉDITO ILUSTRACIONES -->
          <div
            class="mt-5
                  flex
                  items-center
                  gap-2"
          >
            <p
              class="font-heading
                    text-[11px]
                    md:text-xs
                    tracking-[0.18em]
                    uppercase
                    text-gray-400"
            >
              Ilustraciones por Francisco Díaz
            </p>

            <a
              href="https://www.instagram.com/francisco.diaz.duende?stkn=cTRzNGpicDhicDkx"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de Francisco Díaz"
              class="text-gray-500
                    transition-colors
                    duration-300
                    hover:text-red-700"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-4 h-4"
                aria-hidden="true"
              >
                <path
                  d="M7.75 2h8.5A5.756 5.756 0 0 1 22 7.75v8.5A5.756 5.756 0 0 1 16.25 22h-8.5A5.756 5.756 0 0 1 2 16.25v-8.5A5.756 5.756 0 0 1 7.75 2Zm0 2A3.754 3.754 0 0 0 4 7.75v8.5A3.754 3.754 0 0 0 7.75 20h8.5A3.754 3.754 0 0 0 20 16.25v-8.5A3.754 3.754 0 0 0 16.25 4Zm8.75 1.5a1 1 0 1 1-1 1 1 1 0 0 1 1-1ZM12 7a5 5 0 1 1-5 5 5.006 5.006 0 0 1 5-5Zm0 2a3 3 0 1 0 3 3 3.003 3.003 0 0 0-3-3Z"
                />
              </svg>
            </a>
          </div>

        </div>


        <!-- Grilla -->
        <div
          class="grid
                 grid-cols-1
                 sm:grid-cols-2
                 lg:grid-cols-4
                 gap-x-8
                 gap-y-12"
        >

          {
            ilustraciones.map((obra) => (

              <article class="group">

                <!-- ======================================================
                    IMAGEN CLICKEABLE PARA LIGHTBOX
                ====================================================== -->

                <div
                  class="overflow-hidden
                        border
                        border-white/10
                        bg-neutral-950"
                >

                  <button
                    type="button"
                    class="block
                          w-full
                          cursor-zoom-in"
                    data-lightbox
                    data-src={obra.imagen}
                    data-alt={`${obra.numero} - ${obra.titulo}`}
                    aria-label={`Ver ilustración ${obra.titulo} ampliada`}
                  >

                    <img
                      src={obra.imagen}
                      alt={`${obra.numero} - ${obra.titulo}`}
                      width={obra.width}
                      height={obra.height}
                      loading="lazy"
                      class="w-full
                            aspect-square
                            object-cover
                            transition-transform
                            duration-500
                            group-hover:scale-[1.03]"
                    />

                  </button>

                </div>


                <!-- Información -->
                <div class="pt-5">

                  <p
                    class="font-heading
                           text-[10px]
                           tracking-[0.35em]
                           uppercase
                           text-red-500"
                  >
                    {obra.numero}
                  </p>

                  <h3
                    class="mt-2
                           font-heading
                           text-xl
                           tracking-[0.08em]
                           uppercase
                           text-white"
                  >
                    {obra.titulo}
                  </h3>

                </div>

              </article>

            ))
          }

        </div>

      </div>

    </section>

    <!-- ======================================================
         LIGHTBOX / MODAL
    ====================================================== -->

    <div
    id="lightbox"
    class="fixed
          inset-0
          z-[100]
          hidden
          items-center
          justify-center
          bg-black/90
          p-4
          md:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Ilustración ampliada"
    aria-hidden="true"
  >

    <!-- Botón X -->

    <button
      id="lightbox-close"
      type="button"
      class="absolute
            top-5
            right-5
            z-[110]
            flex
            h-11
            w-11
            items-center
            justify-center
            border
            border-white/20
            bg-black/60
            text-xl
            text-white
            transition
            hover:border-white/60
            hover:bg-white/10"
      aria-label="Cerrar imagen"
    >
      ×
    </button>


    <!-- Imagen ampliada -->

    <img
      id="lightbox-image"
      alt=""
      class="max-h-[88vh]
            max-w-[92vw]
            object-contain"
    />

  </div>


  </main>

  <script>
    const lightbox =
      document.getElementById('lightbox');

    const lightboxImage =
      document.getElementById(
        'lightbox-image'
      ) as HTMLImageElement | null;

    const closeButton =
      document.getElementById(
        'lightbox-close'
      ) as HTMLButtonElement | null;

    const openButtons =
      document.querySelectorAll<HTMLButtonElement>(
        '[data-lightbox]'
      );


    let lastFocusedElement: HTMLElement | null = null;


    function isLightboxOpen() {
      return (
        lightbox?.getAttribute('aria-hidden') === 'false'
      );
    }


    function openLightbox(
      src: string,
      alt: string
    ) {

      if (
        !lightbox ||
        !lightboxImage ||
        !closeButton
      ) {
        return;
      }


      if (
        document.activeElement instanceof HTMLElement
      ) {
        lastFocusedElement =
          document.activeElement;
      }


      // Cargar la imagen solamente al abrir.
      lightboxImage.src = src;
      lightboxImage.alt = alt;


      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');

      lightbox.setAttribute(
        'aria-hidden',
        'false'
      );


      document.body.style.overflow = 'hidden';


      // Llevar foco al botón cerrar.
      requestAnimationFrame(() => {
        closeButton.focus();
      });
    }


    function closeLightbox() {

      if (
        !lightbox ||
        !lightboxImage
      ) {
        return;
      }


      if (!isLightboxOpen()) {
        return;
      }


      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');

      lightbox.setAttribute(
        'aria-hidden',
        'true'
      );


      // Evitar src=""
      lightboxImage.removeAttribute('src');
      lightboxImage.alt = '';


      document.body.style.overflow = '';


      // Devolver foco a la ilustración original.
      lastFocusedElement?.focus();
      lastFocusedElement = null;
    }


    // Abrir lightbox.
    openButtons.forEach((button) => {

      button.addEventListener(
        'click',
        () => {

          const src =
            button.getAttribute('data-src');

          const alt =
            button.getAttribute('data-alt') || '';

          if (src) {
            openLightbox(src, alt);
          }

        }
      );

    });


    // Botón cerrar.
    closeButton?.addEventListener(
      'click',
      closeLightbox
    );


    // Cerrar al hacer clic en el fondo.
    lightbox?.addEventListener(
      'click',
      (event) => {

        if (event.target === lightbox) {
          closeLightbox();
        }

      }
    );


    // Control por teclado.
    document.addEventListener(
      'keydown',
      (event) => {

        if (!isLightboxOpen()) {
          return;
        }


        if (event.key === 'Escape') {

          event.preventDefault();

          closeLightbox();

          return;
        }


        // El único elemento interactivo del modal
        // es el botón de cierre.
        if (event.key === 'Tab') {

          event.preventDefault();

          closeButton?.focus();

        }

      }
    );
  </script>

      <!-- ======================================================
         PIE INTERNO DE LA SECCIÓN
    ======================================================= -->

    <footer
      class="border-t
             border-white/10
             py-14"
    >
      <div
        class="section-container
               text-center"
      >
        <p
          class="font-heading
                 text-gray-400
                 text-[10px]
                 uppercase
                 tracking-[0.3em]"
        >
          Nementia · Valparaíso, Chile
        </p>
      </div>
    </footer>

</BaseLayout>
