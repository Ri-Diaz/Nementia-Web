---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contacto | Nementia"
  description="Contacto oficial de Nementia para booking, prensa, colaboraciones y otras consultas."
>

  <main id="main-content" class="relative min-h-[calc(100vh-70px)] bg-black overflow-x-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/banner4.jpg"
        alt=""
        width="2400"
        height="1600"
        class="w-full h-full object-cover object-center opacity-45 blur-[3px] grayscale"
      />

      <div class="absolute inset-0 bg-black/60"></div>

      <!-- Gradiente inferior -->
      <div
        class="absolute
              inset-x-0
              bottom-0
              h-[45%]
              bg-gradient-to-b
              from-transparent
              via-black/45
              to-black"
      ></div>
    </div>

    <!-- =========================================================
         CONTACTO
    ========================================================== -->

    <section
      class="relative
             z-10
             min-h-[470px]
             md:min-h-[500px]
             flex
             items-center
             justify-center"
    >



      <!-- CONTENIDO -->
      <div
        class="relative
               z-10
               w-full
               max-w-3xl
               mx-auto
               text-center
               translate-y-10
               md:translate-y-18"
      >

        <!-- ETIQUETA -->
        <p
          class="font-heading
                 text-[11px]
                 md:text-xs
                 tracking-[0.4em]
                 uppercase
                 text-red-500"
        >
          Booking · Prensa
        </p>

        <!-- TÍTULO -->
        <h1
          class="mt-5
                 font-display
                 text-5xl
                 md:text-6xl
                 lg:text-7xl
                 uppercase
                 text-white"
        >
          Contacto
        </h1>

        <!-- LÍNEA -->
        <div
          class="mx-auto
                 mt-6
                 h-px
                 w-12
                 bg-red-700"
        ></div>

        <!-- TEXTO -->
        <p
          class="mt-9
                 text-base
                 md:text-lg
                 text-slate-400"
        >
          Para booking, prensa, colaboraciones y otras consultas.
        </p>

        <!-- CORREO -->
        <a
          href="mailto:nementia.band@gmail.com"
          class="inline-block
                 mt-5
                 font-heading
                 text-lg
                 md:text-xl
                 tracking-[0.08em]
                 text-white
                 transition-colors
                 duration-300
                 hover:text-red-500"
        >
          nementia.band@gmail.com
        </a>


        <!-- =====================================================
             REDES SOCIALES
        ====================================================== -->

        <div
          class="mt-10
                 flex
                 items-center
                 justify-center
                 gap-7"
        >

          <!-- SPOTIFY -->
          <a
            href="https://open.spotify.com/artist/013o3IJujXyd1L4cCUTi6p"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Spotify"
            class="text-slate-300
                   transition-colors
                   duration-300
                   hover:text-white"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5"
              aria-hidden="true"
            >
              <path
                d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm4.587 14.424a.622.622 0 0 1-.855.207c-2.343-1.431-5.294-1.755-8.77-.961a.622.622 0 1 1-.277-1.213c3.805-.87 7.067-.498 9.695 1.108a.622.622 0 0 1 .207.859Zm1.221-2.716a.778.778 0 0 1-1.07.258c-2.684-1.649-6.776-2.127-9.95-1.164a.778.778 0 1 1-.451-1.489c3.628-1.101 8.136-.568 11.213 1.323a.778.778 0 0 1 .258 1.072Zm.105-2.827C14.694 8.97 9.382 8.795 6.31 9.727a.934.934 0 1 1-.542-1.787c3.527-1.07 9.397-.864 13.096 1.331a.934.934 0 1 1-.951 1.61Z"
              />
            </svg>
          </a>

          <!-- YOUTUBE -->
          <a
            href="https://www.youtube.com/@nementia_band"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="text-slate-300
                   transition-colors
                   duration-300
                   hover:text-white"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5"
              aria-hidden="true"
            >
              <path
                d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.376.505A3.016 3.016 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.376-.505a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"
              />
            </svg>
          </a>

          <!-- INSTAGRAM -->
          <a
            href="https://www.instagram.com/nementia_band"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="text-slate-300
                   transition-colors
                   duration-300
                   hover:text-white"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5"
              aria-hidden="true"
            >
              <path
                d="M7.75 2h8.5A5.756 5.756 0 0 1 22 7.75v8.5A5.756 5.756 0 0 1 16.25 22h-8.5A5.756 5.756 0 0 1 2 16.25v-8.5A5.756 5.756 0 0 1 7.75 2Zm0 2A3.754 3.754 0 0 0 4 7.75v8.5A3.754 3.754 0 0 0 7.75 20h8.5A3.754 3.754 0 0 0 20 16.25v-8.5A3.754 3.754 0 0 0 16.25 4Zm8.75 1.5a1 1 0 1 1-1 1 1 1 0 0 1 1-1ZM12 7a5 5 0 1 1-5 5 5.006 5.006 0 0 1 5-5Zm0 2a3 3 0 1 0 3 3 3.003 3.003 0 0 0-3-3Z"
              />
            </svg>
          </a>

          <!-- FACEBOOK -->
          <a
            href="https://www.facebook.com/nementia.band"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="text-slate-300
                   transition-colors
                   duration-300
                   hover:text-white"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5"
              aria-hidden="true"
            >
              <path
                d="M13.5 22v-9h3l.5-3h-3.5V8.2c0-.868.241-1.46 1.485-1.46H17V4.06A26.9 26.9 0 0 0 14.69 4C12.404 4 10.84 5.395 10.84 7.96V10H8v3h2.84v9Z"
              />
            </svg>
          </a>

          <!-- APPLE MUSIC -->
          <a
            href="https://music.apple.com/cl/artist/nementia/1712198198"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Apple Music"
            class="text-slate-300
                   transition-colors
                   duration-300
                   hover:text-white"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5"
              aria-hidden="true"
            >
              <path
                d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.79 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09ZM12.03 7.25C11.88 5.02 13.69 3.18 15.77 3c.29 2.58-2.34 4.5-3.74 4.25Z"
              />
            </svg>
          </a>

        </div>

      </div>

    </section>



    <!-- =========================================================
         FOOTER
    ========================================================== -->

    <footer
      class="relative
             z-10
             py-8
             md:py-10"
    >

      <div
        class="section-container
               flex
               flex-col
               items-center
               text-center"
      >

        <!-- LOGO -->
        <a
          href="/"
          aria-label="Volver al inicio"
          class="block"
        >
          <img
            src="/images/nementia-logo.webp"
            alt="Nementia"
            width="512"
            height="141"
            class="w-[220px]
                   md:w-[260px]
                   h-auto
                   opacity-90"
          />
        </a>

        <!-- UBICACIÓN -->
        <p
          class="mt-2
                 font-heading
                 text-[10px]
                 md:text-xs
                 tracking-[0.4em]
                 uppercase
                 text-slate-400"
        >
          Valparaíso · Chile
        </p>

        <!-- COPYRIGHT -->
        <p
          class="mt-3
                 text-xs
                 text-slate-400"
        >
          © 2026 Nementia. Todos los derechos reservados.
        </p>

      </div>

    </footer>

  </main>

</BaseLayout>
