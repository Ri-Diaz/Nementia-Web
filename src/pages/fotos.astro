    height: 2000,
  },
  {
    src: '/images/foto-03.jpg',
    alt: 'Nementia en vivo - fotografía 03',
    width: 1920,
    height: 1280,
  },
  {
    src: '/images/foto-04.jpg',
    alt: 'Nementia en vivo - fotografía 04',
    width: 1200,
    height: 1500,
  },
  {
    src: '/images/foto-05.jpg',
    alt: 'Nementia en vivo - fotografía 05',
    width: 2000,
    height: 1333,
  },
  {
    src: '/images/foto-06.jpg',
    alt: 'Nementia en vivo - fotografía 06',
    width: 2000,
    height: 1335,
  },
  {
    src: '/images/foto-07.jpg',
    alt: 'Nementia en vivo - fotografía 07',
    width: 1335,
    height: 2000,
  },
  {
    src: '/images/foto-08.jpg',
    alt: 'Nementia en vivo - fotografía 08',
    width: 1200,
    height: 800,
  },
  {
    src: '/images/foto-09.jpg',
    alt: 'Nementia en vivo - fotografía 09',
    width: 1335,
    height: 2000,
  },
  {
    src: '/images/foto-10.jpg',
    alt: 'Nementia en vivo - fotografía 10',
    width: 1200,
    height: 800,
  },
  {
    src: '/images/foto-11.jpg',
    alt: 'Nementia en vivo - fotografía 11',
    width: 1200,
    height: 1500,
  },
  {
    src: '/images/foto-12.jpg',
    alt: 'Nementia en vivo - fotografía 12',
    width: 1200,
    height: 800,
  },
  {
    src: '/images/foto-13.jpg',
    alt: 'Nementia en vivo - fotografía 13',
    width: 2000,
    height: 1335,
  },
  {
    src: '/images/foto-14.jpg',
    alt: 'Nementia en vivo - fotografía 14',
    width: 1200,
    height: 1500,
