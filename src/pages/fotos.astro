---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Música | Nementia"
  description="Discografía oficial de Nementia."
>
  <main class="min-h-screen pt-32">
    <section class="section-container py-20">

      <p
        class="font-heading
               text-[var(--accent-red)]
               text-xs
               tracking-[0.4em]
               uppercase
               mb-4"
      >
        Nementia
      </p>

      <h1
        class="font-display
               text-5xl
               md:text-6xl
               uppercase"
      >
        Música
      </h1>

    </section>
  </main>
</BaseLayout>