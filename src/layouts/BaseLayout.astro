---
import '../styles/global.css';
import Header from '../components/Header.astro';

const {
  title = 'Nementia | Official Website',
  description = 'Sitio oficial de Nementia.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <!-- ======================================================
         TIPOGRAFÍAS
    ====================================================== -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@300;400;500;600&family=Cormorant+Garamond:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <!-- ======================================================
        ICONOS - FONT AWESOME
    ====================================================== -->

    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
    />
    
  </head>

  <body>

  <!-- ======================================================
       HEADER GLOBAL
  ====================================================== -->

  <Header />


  <!-- ======================================================
       CONTENIDO DE CADA PÁGINA
  ====================================================== -->

  <slot />

</body>
</html>